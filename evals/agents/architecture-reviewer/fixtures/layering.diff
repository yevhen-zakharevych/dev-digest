index 1111111..2222222 100644
--- a/server/src/modules/checkout/domain/pricing.ts
+++ b/server/src/modules/checkout/domain/pricing.ts
@@ -1,3 +1,5 @@
+import type { FastifyRequest } from 'fastify';
+
 export interface CheckoutOrder {
   id: string;
   items: { sku: string; price: number; qty: number }[];
@@ -5,8 +7,9 @@ export interface CheckoutOrder {

-export function priceOrder(order: CheckoutOrder): number {
-  return order.items.reduce((sum, i) => sum + i.price * i.qty, 0);
+export function priceOrder(order: CheckoutOrder, req: FastifyRequest): number {
+  const currency = (req.headers['x-currency'] as string) ?? 'USD';
+  const total = order.items.reduce((sum, i) => sum + i.price * i.qty, 0);
+  return currency === 'EUR' ? total * 0.92 : total;
 }

