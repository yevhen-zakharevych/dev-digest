# Base URL of the running DevDigest Fastify API. Start it first with
# `./scripts/dev.sh` from the repo root (Postgres + API + web).
DEVDIGEST_API_URL=http://localhost:3001

# Max time run_agent_on_pr blocks waiting for a review to finish before it
# hands back { run_id, status: "running" }. Milliseconds.
# MUST stay under the MCP client's 60s request timeout, or the client aborts the
# call with "-32001 Request timed out" mid-review. Values above 55000 are
# clamped down to 55000 for that reason. Slower reviews return a running handoff;
# finish them with get_findings using the returned run_id.
MAX_WAIT_MS=45000
